/* GeoCalc Pro - Professional Engineering Dark Theme */

QMainWindow, QWidget {
    background-color: #1A2332;
    color: #E2E8F0;
    font-family: "Segoe UI", "SF Pro Display", Arial, sans-serif;
    font-size: 13px;
}

/* ── Sidebar ─────────────────────────────────────────────────────────── */
QFrame#sidebar {
    background-color: #0F1923;
    border-right: 1px solid #2D3F54;
}

QLabel#sidebarHeader {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1B4C8A, stop:1 #0F2D5C);
    color: white;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 2px;
    border-bottom: 2px solid #2980B9;
    padding: 12px;
}

QLabel#sidebarSection {
    color: #5B7FA6;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
    padding: 12px 16px 4px 16px;
    text-transform: uppercase;
}

QPushButton#navButton {
    background-color: transparent;
    color: #A0B4C8;
    border: none;
    border-left: 3px solid transparent;
    padding: 10px 16px;
    text-align: left;
    font-size: 13px;
}

QPushButton#navButton:hover {
    background-color: #1A2E44;
    color: #E2E8F0;
    border-left-color: #2980B9;
}

QPushButton#navButton:checked {
    background-color: #1B3A5C;
    color: #4FC3F7;
    border-left-color: #4FC3F7;
    font-weight: bold;
}

QPushButton#settingsButton {
    background-color: #0F1923;
    color: #7090A8;
    border: none;
    border-top: 1px solid #2D3F54;
    padding: 12px 16px;
    text-align: left;
    font-size: 12px;
}

QPushButton#settingsButton:hover {
    background-color: #1A2E44;
    color: #E2E8F0;
}

QLabel#currentProjectLabel {
    color: #4FC3F7;
    font-size: 11px;
    padding: 8px 12px;
    border-top: 1px solid #2D3F54;
    background: #111C28;
}

/* ── Panels ──────────────────────────────────────────────────────────── */
QFrame#panelFrame {
    background-color: #1E2D3D;
    border-right: 1px solid #2D3F54;
}

QLabel#panelTitle {
    font-size: 20px;
    font-weight: bold;
    color: #E2E8F0;
    padding: 8px 4px 16px 4px;
}

QLabel#sectionLabel {
    font-size: 15px;
    font-weight: bold;
    color: #A0C4E8;
}

/* ── Buttons ─────────────────────────────────────────────────────────── */
QPushButton#primaryButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2980B9, stop:1 #1A5E8A);
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px 18px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#primaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #3498DB, stop:1 #2176AE);
}

QPushButton#primaryButton:pressed {
    background: #1A5E8A;
}

QPushButton#primaryButton:disabled {
    background: #2D3F54;
    color: #5B7FA6;
}

QPushButton#dangerButton {
    background: #8B2020;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 8px 18px;
    font-weight: bold;
}

QPushButton#dangerButton:hover {
    background: #B22222;
}

QPushButton {
    background-color: #243447;
    color: #B8CCD8;
    border: 1px solid #2D3F54;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #2D4460;
    color: #E2E8F0;
}

/* ── Inputs ──────────────────────────────────────────────────────────── */
QLineEdit, QTextEdit, QDoubleSpinBox, QSpinBox {
    background-color: #141F2D;
    color: #E2E8F0;
    border: 1px solid #2D3F54;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #2980B9;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: #2980B9;
}

/* ── Lists & Trees ───────────────────────────────────────────────────── */
QListWidget#projectList, QTreeWidget#resultTree {
    background-color: #141F2D;
    border: 1px solid #2D3F54;
    border-radius: 4px;
    color: #C8D8E8;
    alternate-background-color: #19273A;
}

QListWidget#projectList::item, QTreeWidget#resultTree::item {
    padding: 4px 8px;
    border-bottom: 1px solid #1E2D3D;
}

QListWidget#projectList::item:selected,
QTreeWidget#resultTree::item:selected {
    background-color: #1B3A5C;
    color: #4FC3F7;
}

QListWidget#projectList::item:hover,
QTreeWidget#resultTree::item:hover {
    background-color: #1A2E44;
}

QTreeWidget {
    background-color: #141F2D;
    border: 1px solid #2D3F54;
    border-radius: 4px;
    color: #C8D8E8;
}

QHeaderView::section {
    background-color: #0F1923;
    color: #7090A8;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #2D3F54;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ── Toolbar ─────────────────────────────────────────────────────────── */
QToolBar#mapToolbar {
    background-color: #0F1923;
    border-bottom: 1px solid #2D3F54;
    padding: 4px 8px;
    spacing: 4px;
}

QLabel#toolbarTitle {
    color: #4FC3F7;
    font-weight: bold;
    font-size: 14px;
}

/* ── Progress Bar ────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #141F2D;
    border: 1px solid #2D3F54;
    border-radius: 4px;
    height: 18px;
    text-align: center;
    color: white;
    font-size: 11px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1A5E8A, stop:1 #2980B9);
    border-radius: 3px;
}

/* ── Tabs ────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #2D3F54;
    background: #1E2D3D;
}

QTabBar::tab {
    background: #141F2D;
    color: #7090A8;
    border: 1px solid #2D3F54;
    border-bottom: none;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #1E2D3D;
    color: #4FC3F7;
    border-top: 2px solid #2980B9;
}

QTabBar::tab:hover {
    background: #1A2E44;
    color: #E2E8F0;
}

/* ── Menus ───────────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #0F1923;
    color: #A0B4C8;
    border-bottom: 1px solid #2D3F54;
}

QMenuBar::item:selected {
    background-color: #1A2E44;
    color: white;
}

QMenu {
    background-color: #141F2D;
    color: #E2E8F0;
    border: 1px solid #2D3F54;
}

QMenu::item:selected {
    background-color: #1B3A5C;
}

/* ── Status Bar ──────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #0F1923;
    color: #5B7FA6;
    border-top: 1px solid #2D3F54;
    font-size: 12px;
}

/* ── Group Box ───────────────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #2D3F54;
    border-radius: 5px;
    margin-top: 8px;
    color: #7090A8;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #5B9BD5;
}

/* ── Splitter ────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #2D3F54;
    width: 1px;
}

/* ── Scroll Bars ─────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #141F2D;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #2D4460;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #2980B9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #141F2D;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #2D4460;
    border-radius: 4px;
}

/* ── Dialog ──────────────────────────────────────────────────────────── */
QDialog {
    background-color: #1A2332;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
    padding: 7px 16px;
}
